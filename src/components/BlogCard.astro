---
import {
  getCombinedReadingTime,
  getSubpostCount,
  isSubpost,
} from '@/lib/data-utils'
import { formatDate } from '@/lib/utils'
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

interface Props {
  entry: CollectionEntry<'blog'>
}

const { entry } = Astro.props
const formattedDate = formatDate(entry.data.date)
const readTime = await getCombinedReadingTime(entry.id)
const subpostCount = !isSubpost(entry.id) ? await getSubpostCount(entry.id) : 0
---

<a
  href={`/${entry.collection}/${entry.id}`}
  class="group grid gap-4 border-t py-6 sm:grid-cols-[10rem_minmax(0,1fr)] sm:gap-6"
>
  {
    entry.data.image && (
      <div class="bg-muted hidden aspect-[1200/630] w-full self-start overflow-hidden rounded-[4px] sm:block">
        {typeof entry.data.image === 'string' ? (
          <img
            src={entry.data.image}
            alt=""
            width={1200}
            height={630}
            loading="lazy"
            class="block h-full w-full object-cover transition-opacity duration-300 group-hover:opacity-90"
          />
        ) : (
          <Image
            src={entry.data.image}
            alt=""
            width={480}
            height={252}
            class="block h-full w-full object-cover transition-opacity duration-300 group-hover:opacity-90"
          />
        )}
      </div>
    )
  }

  <div class:list={['min-w-0', !entry.data.image && 'sm:col-span-2']}>
    <h3
      class="group-hover:text-accent text-lg leading-snug font-semibold tracking-[-0.015em] text-balance transition-colors"
    >
      {entry.data.title}
    </h3>
    <p class="text-muted-foreground mt-1.5 text-[0.95rem] leading-relaxed">
      {entry.data.description}
    </p>
    <p
      class="text-muted-foreground/80 mt-3 flex flex-wrap gap-x-3 gap-y-1 text-[0.8125rem]"
    >
      <time datetime={entry.data.date.toISOString()}>{formattedDate}</time>
      <span aria-hidden="true">&middot;</span>
      <span>{readTime}</span>
      {
        subpostCount > 0 && (
          <>
            <span aria-hidden="true">&middot;</span>
            <span>
              {subpostCount} subpost{subpostCount === 1 ? '' : 's'}
            </span>
          </>
        )
      }
    </p>
    {
      entry.data.tags && entry.data.tags.length > 0 && (
        <p class="text-muted-foreground/70 mt-1 text-[0.8125rem]">
          {entry.data.tags.join(', ')}
        </p>
      )
    }
  </div>
</a>
