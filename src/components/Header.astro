---
import Link from '@/components/Link.astro'
import ThemeToggle from '@/components/ThemeToggle.astro'
import { NAV_LINKS, SITE } from '@/consts'

const path = Astro.url.pathname
const isActive = (href: string) => path === href || path.startsWith(`${href}/`)
---

<div>
  <div
    class="mx-auto flex max-w-3xl items-center justify-between gap-3 px-4 py-3"
  >
    <Link href="/" class="flex shrink-0 items-center justify-center gap-3">
      <span class="text-base leading-none font-medium tracking-tight sm:text-lg"
        >{SITE.title}</span
      >
    </Link>
    <div class="flex items-center gap-3 sm:gap-4">
      <nav class="flex items-center gap-3.5 text-sm sm:gap-6" aria-label="Main">
        {
          NAV_LINKS.map((item) => (
            <Link
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class="text-foreground/60 hover:text-foreground aria-[current=page]:text-foreground capitalize transition-colors"
            >
              {item.label}
            </Link>
          ))
        }
      </nav>
      <ThemeToggle transition:persist />
    </div>
  </div>
</div>
