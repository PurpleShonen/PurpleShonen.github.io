---
import { cn } from '@/lib/utils'
import { Icon } from 'astro-icon/components'

const { newerPost, olderPost, parentPost } = Astro.props
const isSubpost = !!parentPost

const item =
  'group flex h-full flex-col gap-1 border-t py-5 transition-colors'
const disabled = 'pointer-events-none opacity-40'
---

<nav
  aria-label="Post navigation"
  class={cn(
    'col-start-2 grid grid-cols-1 gap-x-8',
    isSubpost ? 'sm:grid-cols-3' : 'sm:grid-cols-2',
  )}
>
  <a
    href={olderPost ? `/blog/${olderPost.id}#post-title` : undefined}
    class={cn(item, !olderPost && disabled)}
    aria-disabled={!olderPost}
  >
    <span class="text-muted-foreground inline-flex items-center gap-1.5 text-xs">
      <Icon
        name="lucide:arrow-left"
        class="size-3.5 transition-transform duration-300 group-hover:-translate-x-0.5"
      />
      {isSubpost ? 'Previous subpost' : 'Previous'}
    </span>
    <span class="group-hover:text-accent text-[0.95rem] leading-snug font-semibold text-balance transition-colors">
      {
        olderPost?.data.title ||
          (isSubpost ? 'No older subpost' : 'This is the oldest post')
      }
    </span>
  </a>

  {
    isSubpost && (
      <a
        href={parentPost ? `/blog/${parentPost.id}#post-title` : undefined}
        class={cn(item, 'sm:items-center sm:text-center', !parentPost && disabled)}
      >
        <span class="text-muted-foreground inline-flex items-center gap-1.5 text-xs">
          <Icon name="lucide:corner-left-up" class="size-3.5" />
          Parent post
        </span>
        <span class="group-hover:text-accent text-[0.95rem] leading-snug font-semibold text-balance transition-colors">
          {parentPost?.data.title || 'No parent post'}
        </span>
      </a>
    )
  }

  <a
    href={newerPost ? `/blog/${newerPost.id}#post-title` : undefined}
    class={cn(item, 'sm:items-end sm:text-right', !newerPost && disabled)}
    aria-disabled={!newerPost}
  >
    <span class="text-muted-foreground inline-flex items-center gap-1.5 text-xs">
      {isSubpost ? 'Next subpost' : 'Next'}
      <Icon
        name="lucide:arrow-right"
        class="size-3.5 transition-transform duration-300 group-hover:translate-x-0.5"
      />
    </span>
    <span class="group-hover:text-accent text-[0.95rem] leading-snug font-semibold text-balance transition-colors">
      {
        newerPost?.data.title ||
          (isSubpost ? 'No newer subpost' : 'This is the newest post')
      }
    </span>
  </a>
</nav>
