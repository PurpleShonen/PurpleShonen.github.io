---
import Link from '@/components/Link.astro'
import { Badge } from '@/components/ui/badge'
import { formatDate } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

interface Props {
  project: CollectionEntry<'projects'>
}

const { project } = Astro.props
---

<div
  class="group hover:bg-muted/40 hover:border-foreground/15 rounded-xl border transition-colors duration-300 ease-out"
>
  <Link
    href={project.data.link ?? '/projects'}
    class="flex flex-col gap-4 rounded-xl p-4 sm:flex-row sm:gap-5"
    external={Boolean(project.data.link)}
    rel={project.data.link ? 'noopener' : undefined}
  >
    {
      project.data.image && (
        <div class="w-full sm:max-w-3xs sm:shrink-0">
          {typeof project.data.image === 'string' ? (
            <img
              src={project.data.image}
              alt={project.data.name}
              width={1200}
              height={630}
              class="aspect-[1200/630] w-full rounded-md object-cover"
            />
          ) : (
            <Image
              src={project.data.image}
              alt={project.data.name}
              width={1200}
              height={630}
              class="aspect-[1200/630] w-full rounded-md object-cover"
            />
          )}
        </div>
      )
    }
    <div class="min-w-0 grow">
      <h3 class="group-hover:text-primary mb-1 text-lg leading-snug font-medium transition-colors">
        {project.data.name}
      </h3>
      <p class="text-muted-foreground mb-2 text-sm">
        {project.data.description}
      </p>
      {
        project.data.startDate && (
          <p class="text-muted-foreground/70 mb-2 flex items-center gap-x-1.5 text-xs">
            <span class="flex items-center gap-x-1.5">
              <Icon name="lucide:calendar" class="size-3" />
              <span>
                {formatDate(project.data.startDate)}
                {project.data.endDate
                  ? ` → ${formatDate(project.data.endDate)}`
                  : ' → Present'}
              </span>
            </span>
          </p>
        )
      }
      {
        project.data.tags && (
          <div class="flex flex-wrap gap-2">
            {project.data.tags.map((tag: string) => (
              <Badge variant="muted">{tag}</Badge>
            ))}
          </div>
        )
      }
    </div>
  </Link>
</div>
