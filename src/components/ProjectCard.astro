---
import { formatDate } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

interface Props {
  project: CollectionEntry<'projects'>
}

const { project } = Astro.props
const { link, image, name, description, startDate, endDate, tags } =
  project.data
---

<a
  href={link ?? '/projects'}
  target={link ? '_blank' : undefined}
  rel={link ? 'noopener' : undefined}
  class="group grid gap-4 border-t py-6 sm:grid-cols-[10rem_minmax(0,1fr)] sm:gap-6"
>
  {
    image && (
      <div class="bg-muted ring-border aspect-[1200/630] w-full self-start overflow-hidden rounded-[4px] ring-1">
        {typeof image === 'string' ? (
          <img
            src={image}
            alt=""
            width={1200}
            height={630}
            loading="lazy"
            class="block h-full w-full object-cover transition-opacity duration-300 group-hover:opacity-90"
          />
        ) : (
          <Image
            src={image}
            alt=""
            width={480}
            height={252}
            class="block h-full w-full object-cover transition-opacity duration-300 group-hover:opacity-90"
          />
        )}
      </div>
    )
  }

  <div class:list={['min-w-0', !image && 'sm:col-span-2']}>
    <h3
      class="group-hover:text-accent inline-flex items-center gap-1.5 text-lg leading-snug font-semibold tracking-[-0.015em] transition-colors"
    >
      {name}
      {
        link && (
          <Icon
            name="lucide:arrow-up-right"
            class="size-4 opacity-50 transition-opacity group-hover:opacity-100"
          />
        )
      }
    </h3>
    <p class="text-muted-foreground mt-1.5 text-[0.95rem] leading-relaxed">
      {description}
    </p>
    <p
      class="text-muted-foreground/80 mt-3 flex flex-wrap gap-x-3 gap-y-1 text-[0.8125rem]"
    >
      {
        startDate && (
          <span>
            {formatDate(startDate)} – {endDate ? formatDate(endDate) : 'Present'}
          </span>
        )
      }
    </p>
    {
      tags && tags.length > 0 && (
        <p class="text-muted-foreground/70 mt-1 text-[0.8125rem]">
          {tags.join(', ')}
        </p>
      )
    }
  </div>
</a>
