---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import { Icon } from 'astro-icon/components'
import publicKey from '../../public/downloadables/purpleshonen-publickey.asc?raw'

import yamlData from '../data/certifications.yml'

interface Certificate {
  name: string
  image: string | { src: string }
  alt: string
  caption: string
}

const sortedCerts = (yamlData as any).certifications as Certificate[]

const profiles = [
  { href: 'https://www.credly.com/users/rahuljoriya', label: 'Credly' },
  { href: 'https://tryhackme.com/p/PurpleShonen', label: 'TryHackMe' },
  { href: 'https://ctftime.org/user/245301', label: 'CTFtime' },
]

const FINGERPRINT = '6B75FB142C45756BDDE6D6B71D3F2451BEAA03FF'
const fingerprintGroups = FINGERPRINT.match(/.{1,4}/g) ?? []

const linkClass =
  'group link-sweep text-muted-foreground hover:text-accent inline-flex items-center gap-1'
const iconClass =
  'size-3.5 opacity-60 transition-[opacity,translate] duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:opacity-100'
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="About" />
  <Breadcrumbs items={[{ label: 'About', icon: 'lucide:info' }]} />

  <section>
    <h1
      data-headword
      class="mt-4 mb-8 text-4xl font-semibold tracking-[-0.03em] sm:text-6xl"
    >
      About
    </h1>

    <div class="prose" data-intro>
      <p>
        An aspiring SOC analyst focused on security operations — monitoring,
        alert triage, incident investigation, and making sense of what the logs
        are really saying. I use this place to publish investigation writeups,
        document projects, and share notes from my hands-on blue team learning.
      </p>

      <p>
        My focus areas include SIEM and log analysis, network traffic analysis,
        phishing and email investigation, threat intelligence, Linux, and Python
        automation for security workflows. Most of what I learn is distilled
        into clear walkthroughs and tools that others can experiment with
        themselves.
      </p>

      <p>
        I also share tutorials and demonstrations on <a
          href="https://www.youtube.com/@purpleshonen"
          target="_blank"
          rel="noopener">YouTube</a
        >, where I break down cybersecurity concepts into practical,
        beginner-friendly lessons.
      </p>

      <p>
        You can follow my certifications and hands-on lab progress across the
        platforms below:
      </p>
    </div>

    <ul class="mt-4 mb-8 flex flex-wrap gap-x-6 gap-y-2" role="list">
      {
        profiles.map((p) => (
          <li>
            <a href={p.href} target="_blank" rel="noopener" class={linkClass}>
              {p.label}
              <Icon name="lucide:arrow-up-right" class={iconClass} />
            </a>
          </li>
        ))
      }
    </ul>

    <div class="prose">
      <p>
        This site serves as a growing knowledge log — everything shared here is
        something I’ve tested, practiced, or actively studied.
      </p>

      <p>
        PurpleShonen is also my business: a sole proprietorship of Rahul
        Joriya, based in Jodhpur, India, which develops and publishes apps.
      </p>
    </div>
  </section>

  <section class="mt-14" data-reveal>
    <div class="mb-6 flex items-baseline justify-between gap-4 border-b pb-3">
      <h2 class="text-xl font-semibold">Certifications</h2>
      <a
        href="https://www.credly.com/users/rahuljoriya"
        target="_blank"
        rel="noopener"
        class={linkClass + ' text-sm'}
      >
        Verify on Credly
        <Icon name="lucide:arrow-up-right" class={iconClass} />
      </a>
    </div>

    <div
      class="grid grid-cols-2 justify-items-center gap-x-4 gap-y-6 sm:grid-cols-3"
    >
      <div data-iframe-width="152" data-iframe-height="270" data-share-badge-id="ea6b048a-927e-47c6-9e13-f0c13e506a8b" data-share-badge-host="https://www.credly.com"></div>
      <div data-iframe-width="152" data-iframe-height="270" data-share-badge-id="b0aa8684-9d09-47c6-8bc7-9a05c229ac54" data-share-badge-host="https://www.credly.com"></div>
      <div data-iframe-width="152" data-iframe-height="270" data-share-badge-id="6d904561-a859-4e35-a077-419ffd6d6d33" data-share-badge-host="https://www.credly.com"></div>
      <div data-iframe-width="152" data-iframe-height="270" data-share-badge-id="5922f724-9782-4e06-982f-4a794db44b46" data-share-badge-host="https://www.credly.com"></div>
      <div data-iframe-width="152" data-iframe-height="270" data-share-badge-id="fe751831-6719-49a6-8f2c-4b0bb48d5ba3" data-share-badge-host="https://www.credly.com"></div>
      <div data-iframe-width="152" data-iframe-height="270" data-share-badge-id="3e7e48e1-ba0e-4054-ae13-0a4fdd646dd2" data-share-badge-host="https://www.credly.com"></div>
      <script type="text/javascript" async is:inline src="//cdn.credly.com/assets/utilities/embed.js"></script>
    </div>

    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
      <a
        href="/resume.pdf"
        class="group link-sweep text-foreground hover:text-accent inline-flex items-center gap-1 font-semibold"
      >
        Download résumé
        <Icon
          name="lucide:arrow-down"
          class="size-3.5 opacity-60 transition-[opacity,translate] duration-300 group-hover:translate-y-0.5 group-hover:opacity-100"
        />
      </a>
      <button
        type="button"
        class="text-muted-foreground hover:text-accent inline-flex cursor-pointer items-center gap-1.5 transition-colors"
        aria-expanded="false"
        aria-controls="certificates"
        data-toggle-certificates
      >
        <span data-label>Show certificate scans</span>
        <Icon
          name="lucide:chevron-down"
          class="size-4 transition-transform duration-300 [[aria-expanded=true]_&]:rotate-180"
        />
      </button>
    </div>

    <div id="certificates" class="mt-6 hidden space-y-6">
      {
        sortedCerts.map((cert) => (
          <figure>
            <img
              src={typeof cert.image === 'string' ? cert.image : cert.image.src}
              alt={cert.alt}
              class="h-auto w-full max-w-full rounded-md border object-contain"
              loading="lazy"
            />
            <figcaption class="text-muted-foreground mt-2 text-sm">
              {cert.caption}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section class="mt-14" data-reveal>
    <div class="mb-6 border-b pb-3">
      <h2 class="text-xl font-semibold">PGP public key</h2>
    </div>

    <dl class="grid gap-x-8 gap-y-4 text-sm sm:grid-cols-[8rem_minmax(0,1fr)]">
      <dt class="text-muted-foreground">Fingerprint</dt>
      <dd class="font-mono text-[0.95rem] tracking-wide">
        {
          fingerprintGroups.map((g, i) => (
            <span class:list={[i === 5 && 'sm:ml-3']}>{g} </span>
          ))
        }
      </dd>
      <dt class="text-muted-foreground">User ID</dt>
      <dd>rahul.infosec@proton.me</dd>
      <dt class="text-muted-foreground">Type</dt>
      <dd>255-bit EdDSA · signing, encryption, certification</dd>
      <dt class="text-muted-foreground">Valid from</dt>
      <dd>June 28, 2025</dd>
    </dl>

    <details class="group/key mt-6">
      <summary
        class="text-muted-foreground hover:text-accent inline-flex cursor-pointer list-none items-center gap-1.5 text-sm transition-colors [&::-webkit-details-marker]:hidden"
      >
        Show full key
        <Icon
          name="lucide:chevron-down"
          class="size-4 transition-transform duration-300 group-open/key:rotate-180"
        />
      </summary>
      <pre
        class="bg-muted text-muted-foreground mt-4 max-h-80 overflow-auto rounded-md p-4 font-mono text-xs leading-relaxed"
        data-pgp-key>{publicKey.trim()}</pre>
    </details>

    <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3 text-[0.95rem]">
      <button
        type="button"
        class="group link-sweep text-foreground hover:text-accent inline-flex cursor-pointer items-center gap-1.5 font-semibold"
        data-copy-key
      >
        <Icon name="lucide:copy" class="size-3.5" data-icon-copy />
        <Icon name="lucide:check" class="hidden size-3.5" data-icon-done />
        <span data-copy-label>Copy key</span>
      </button>
      <a
        href="/downloadables/purpleshonen-publickey.asc"
        download="purpleshonen-publickey.asc"
        class={linkClass}
      >
        Download .asc
        <Icon
          name="lucide:arrow-down"
          class="size-3.5 opacity-60 transition-[opacity,translate] duration-300 group-hover:translate-y-0.5 group-hover:opacity-100"
        />
      </a>
      <a href="mailto:rahul.infosec@proton.me" class={linkClass}>
        Email me
        <Icon name="lucide:arrow-up-right" class={iconClass} />
      </a>
    </div>
  </section>

  <script>
    const initAbout = () => {
      const btn = document.querySelector<HTMLButtonElement>(
        '[data-toggle-certificates]',
      )
      const panel = document.getElementById('certificates')
      if (btn && panel && btn.dataset.initialized !== 'true') {
        btn.dataset.initialized = 'true'
        const label = btn.querySelector('[data-label]')
        btn.addEventListener('click', () => {
          const open = btn.getAttribute('aria-expanded') !== 'true'
          btn.setAttribute('aria-expanded', String(open))
          panel.classList.toggle('hidden', !open)
          if (label)
            label.textContent = open
              ? 'Hide certificate scans'
              : 'Show certificate scans'
        })
      }

      const copy = document.querySelector<HTMLButtonElement>('[data-copy-key]')
      const key = document.querySelector('[data-pgp-key]')
      if (copy && key && copy.dataset.initialized !== 'true') {
        copy.dataset.initialized = 'true'
        const label = copy.querySelector('[data-copy-label]')
        const iconCopy = copy.querySelector('[data-icon-copy]')
        const iconDone = copy.querySelector('[data-icon-done]')
        copy.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(key.textContent ?? '')
            if (label) label.textContent = 'Copied'
            iconCopy?.classList.add('hidden')
            iconDone?.classList.remove('hidden')
            setTimeout(() => {
              if (label) label.textContent = 'Copy key'
              iconCopy?.classList.remove('hidden')
              iconDone?.classList.add('hidden')
            }, 2000)
          } catch {
            if (label) label.textContent = 'Copy failed — use Download .asc'
          }
        })
      }
    }

    document.addEventListener('astro:page-load', initAbout)
  </script>
</Layout>
