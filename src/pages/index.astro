---
import BlogCard from '@/components/BlogCard.astro'
import PageHead from '@/components/PageHead.astro'
import ProjectCard from '@/components/ProjectCard.astro'
import { HERO_LINKS, SITE } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getAllProjects, getRecentPosts } from '@/lib/data-utils'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import avatar from '@/content/authors/logo.jpg'

const blog = await getRecentPosts(SITE.featuredPostCount)
const projects = (await getAllProjects()).slice(0, 2)

const links = [
  { href: '/resume.pdf', label: 'Résumé', external: false },
  ...HERO_LINKS.map((l) => ({ ...l, external: true })),
]

const CREDLY = 'https://www.credly.com/users/rahuljoriya'
const certifications = [
  { name: 'CompTIA Security+', issuer: 'CompTIA' },
  { name: 'Certified in Cybersecurity (CC)', issuer: 'ISC2' },
  { name: 'ISO/IEC 27001 Lead Auditor', issuer: 'Mastermind Assurance' },
  { name: 'CS50x: Introduction to Computer Science', issuer: 'Harvard · edX' },
  { name: 'LFS101: Introduction to Linux', issuer: 'The Linux Foundation' },
  { name: 'Cybersecurity Fundamentals', issuer: 'IBM SkillsBuild' },
]
---

<Layout class="max-w-3xl">
  <PageHead
    slot="head"
    title="PurpleShonen | Aspiring SOC Analyst, Blue Team & Security Writeups"
  />

  <section class="pt-8 pb-2 sm:pt-16">
    <div class="flex items-center gap-4 sm:gap-6">
      <Image
        src={avatar}
        alt="PurpleShonen avatar"
        width={160}
        height={160}
        loading="eager"
        data-intro
        class="ring-border size-14 shrink-0 rounded-full ring-1 sm:size-[4.5rem]"
      />
      <h1
        data-headword
        class="text-[2.6rem] leading-[0.95] font-semibold tracking-[-0.035em] min-[400px]:text-5xl sm:text-7xl"
      >
        SOC <span class="whitespace-nowrap">An<span class="text-accent">·</span>a<span class="text-accent">·</span>lyst</span>
      </h1>
    </div>
    <p data-intro class="text-muted-foreground mt-4 text-lg">
      /ˌes.oʊˈsiː ˈæn.əl.ɪst/ &middot; <i>noun</i>
    </p>

    <p
      data-intro
      class="text-foreground/90 mt-10 max-w-[62ch] text-lg leading-relaxed"
    >
      An aspiring SOC analyst focused on defending systems — learning to
      monitor, triage alerts, investigate incidents, and turn noisy telemetry
      into clear answers. I build hands-on labs around SIEM, log analysis,
      network traffic, phishing analysis, and threat intelligence, and automate
      the repetitive parts with Python.
    </p>
    <p
      data-intro
      class="text-muted-foreground mt-5 max-w-[62ch] leading-relaxed"
    >
      Recently completed a Master’s in Computer Science. Founder of <a
        href="https://xsecirc.github.io/"
        target="_blank"
        rel="noopener"
        class="text-foreground decoration-muted-foreground hover:decoration-accent underline underline-offset-4 transition-colors"
        >xSecIRC</a
      >, a Discord-based community dedicated to hands-on cybersecurity learning
      and collaborative skill development.
    </p>

    <ul
      data-intro
      class="mt-10 flex flex-wrap gap-x-6 gap-y-3 text-[0.95rem]"
      role="list"
    >
      {
        links.map((l, i) => (
          <li>
            <a
              href={l.href}
              target={l.external ? '_blank' : undefined}
              rel={l.external ? 'noopener' : undefined}
              class:list={[
                'group link-sweep hover:text-accent inline-flex items-center gap-1',
                i === 0
                  ? 'text-foreground font-semibold'
                  : 'text-muted-foreground',
              ]}
            >
              {l.label}
              <Icon
                name={i === 0 ? 'lucide:arrow-down' : 'lucide:arrow-up-right'}
                class:list={[
                  'size-3.5 opacity-60 transition-[opacity,translate] duration-300 group-hover:opacity-100',
                  i === 0
                    ? 'group-hover:translate-y-0.5'
                    : 'group-hover:translate-x-0.5 group-hover:-translate-y-0.5',
                ]}
              />
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-16 sm:mt-20">
    <div class="mb-2 flex items-baseline justify-between gap-4" data-reveal>
      <h2 class="text-xl font-semibold">Writing</h2>
      <a
        href="/blog"
        class="group text-muted-foreground hover:text-accent inline-flex items-center gap-1 text-sm transition-colors"
        >All writeups <Icon
          name="lucide:arrow-right"
          class="size-3.5 transition-transform duration-300 group-hover:translate-x-0.5"
        /></a
      >
    </div>
    <ul class="border-b" role="list">
      {
        blog.map((post) => (
          <li data-reveal>
            <BlogCard entry={post} />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-14 sm:mt-16">
    <div class="mb-2 flex items-baseline justify-between gap-4" data-reveal>
      <h2 class="text-xl font-semibold">Projects</h2>
      <a
        href="/projects"
        class="group text-muted-foreground hover:text-accent inline-flex items-center gap-1 text-sm transition-colors"
        >All projects <Icon
          name="lucide:arrow-right"
          class="size-3.5 transition-transform duration-300 group-hover:translate-x-0.5"
        /></a
      >
    </div>
    <ul class="border-b" role="list">
      {
        projects.map((project) => (
          <li data-reveal>
            <ProjectCard project={project} />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-14 sm:mt-16">
    <div class="mb-2 flex items-baseline justify-between gap-4" data-reveal>
      <h2 class="text-xl font-semibold">Certifications</h2>
      <a
        href={CREDLY}
        target="_blank"
        rel="noopener"
        class="group text-muted-foreground hover:text-accent inline-flex items-center gap-1 text-sm transition-colors"
        >Verify on Credly <Icon
          name="lucide:arrow-up-right"
          class="size-3.5 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        /></a
      >
    </div>
    <ul class="grid border-b sm:grid-cols-2 sm:gap-x-8" role="list">
      {
        certifications.map((c) => (
          <li class="border-t py-4" data-reveal>
            <p class="font-medium">{c.name}</p>
            {c.issuer && (
              <p class="text-muted-foreground mt-0.5 text-sm">{c.issuer}</p>
            )}
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
