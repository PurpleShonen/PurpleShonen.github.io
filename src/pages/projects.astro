---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import PageHead from '@/components/PageHead.astro'
import ProjectCard from '@/components/ProjectCard.astro'
import Layout from '@/layouts/Layout.astro'
import { getAllProjects } from '@/lib/data-utils'

const projects = await getAllProjects()
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="Projects" />
  <Breadcrumbs items={[{ label: 'Projects', icon: 'lucide:folder-git-2' }]} />

  <header class="mt-4">
    <h1
      data-headword
      class="text-4xl font-semibold tracking-[-0.03em] sm:text-6xl"
    >
      Projects
    </h1>
    <p
      data-intro
      class="text-foreground/85 mt-5 max-w-[58ch] text-lg leading-relaxed"
    >
      A collection of my projects, tools, and experiments.
    </p>
    <p data-intro class="text-muted-foreground mt-3 text-sm">
      {projects.length} projects &middot; newest first
    </p>
  </header>

  <ul class="mt-10 flex flex-col border-b" role="list">
    {
      projects.map((project) => (
        <li data-reveal>
          <ProjectCard project={project} />
        </li>
      ))
    }
  </ul>
</Layout>
